{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensmell.org/schema/opensmell-0.1.schema.json",
  "title": "OpenSmell 0.1",
  "description": "Experimental schema for OpenSmell digital olfactory information.",
  "type": "object",
  "required": [
    "opensmell",
    "odor"
  ],
  "properties": {
    "opensmell": {
      "type": "string",
      "const": "0.1"
    },
    "odor": {
      "$ref": "#/$defs/odor"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "odor": {
      "type": "object",
      "required": [
        "id",
        "representations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "representations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/representation"
          }
        }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "representation": {
      "type": "object",
      "required": [
        "type",
        "scheme",
        "data"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "scheme": {
          "$ref": "#/$defs/scheme"
        },
        "data": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "scheme": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
