# ---------------------------------------------------------------------------
# OpenSmell local / external data
# ---------------------------------------------------------------------------

# External OdorNet dataset
examples/odornet.csv

# Generated OpenSmell examples
examples/odornet-example.osmell
examples/odornet-enriched-example.osmell

# PubChem enrichment data
examples/pubchem_cache.json
examples/odornet_enriched.csv

# External Keller/Vosshall olfactory dataset
examples/keller_vosshall.xlsx

# External Burton 2022 experimental dataset
# Contains source CSV, MAT, raw data and dataset-specific files.
# The complete external dataset must not be redistributed from this repository.
examples/burton_2022/

# External UCI Gas Sensor Array Drift dataset
# Contains the 10 source batch files used by the electronic-olfaction
# RFC-0007 stress test. The external dataset is not redistributed here.
examples/gas_sensor_drift/

# Legacy/local external experimental dataset files
examples/molecules.csv
examples/stimuli.csv
examples/subjects.csv
examples/behavior.csv

# Generated JavaScript ResourceGraph interoperability round-trip output.
# The Python-generated interoperability vectors are versioned golden vectors;
# this JavaScript file is only a temporary verification artifact.
examples/resource_graph_interop_vectors_js.json